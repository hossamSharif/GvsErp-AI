<!DOCTYPE html>
<html lang="en" dir="{{ direction }}">
<head>
  <meta charset="UTF-8" />
  <title>{{ party_name }} — Activity Summary</title>
  <style>
    @page { size: A4; margin: 24mm 18mm; @bottom-center { content: counter(page) " / " counter(pages); font-size: 9pt; color: #888; } }
    body { font-family: "Helvetica", "Arial", sans-serif; color: #111; font-size: 11pt; line-height: 1.45; }
    h1 { font-size: 22pt; margin: 0 0 2pt 0; }
    h2 { font-size: 13pt; margin: 18pt 0 6pt 0; color: #333; border-bottom: 1pt solid #eee; padding-bottom: 2pt; }
    .subtitle { color: #666; margin-bottom: 16pt; font-size: 10pt; }
    .narrative { white-space: pre-wrap; margin: 0 0 12pt 0; }
    table { width: 100%; border-collapse: collapse; margin-top: 4pt; font-size: 10pt; }
    th, td { padding: 5pt 7pt; border-bottom: 1pt solid #eee; text-align: start; }
    th { background: #f4f4f4; font-weight: 600; text-transform: uppercase; font-size: 9pt; letter-spacing: 0.5pt; }
    .meta { margin-top: 22pt; font-size: 9pt; color: #888; }
    .empty { color: #888; font-style: italic; }
  </style>
</head>
<body>
  <h1>{{ party_name }}</h1>
  <div class="subtitle">Activity summary generated by the ERP AI companion — grounded in retrieved records.</div>

  <h2>Narrative</h2>
  {% if narrative %}
    <div class="narrative">{{ narrative }}</div>
  {% else %}
    <p class="empty">No narrative was generated.</p>
  {% endif %}

  <h2>Cited documents ({{ citations | length }})</h2>
  {% if citations %}
    <table>
      <thead>
        <tr><th>Source</th><th>Ref</th><th>Status</th><th>Excerpt</th></tr>
      </thead>
      <tbody>
        {% for c in citations %}
          <tr>
            <td>{{ c.source_table }}</td>
            <td>{{ c.ref }}</td>
            <td>{{ c.status }}</td>
            <td>{{ c.excerpt }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="empty">No documents retrieved — run "Re-index ERP" first.</p>
  {% endif %}

  <div class="meta">Generated {{ generated_at }} · ERP AI Companion · Phase 3 RAG</div>
</body>
</html>
