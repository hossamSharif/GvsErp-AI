# ─── LLM providers ──────────────────────────────────────────────
# Gemini (default — free tier available). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional — only if you want to switch providers via the Streamlit dropdown
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

AI_DEFAULT_PROVIDER=google
AI_DEFAULT_MODEL=gemini-2.5-flash-lite

# ─── Supabase (for ERP data + auth + pgvector later) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── ERP API ────────────────────────────────────────────────────
ERP_API_BASE_URL=http://localhost:3001/api/v1

# ─── RAG backend (Phase 4) ──────────────────────────────────────
# chroma   = in-memory (Phase 3 default, no infra)
# pgvector = Supabase ai_embeddings table (run migration 014 first)
RAG_BACKEND=chroma

# ─── Pipelines (Phase 4 scheduler) ──────────────────────────────
# The standalone scheduler runs without a Streamlit session, so it needs an
# explicit tenant + JWT to call the ERP API. The JWT must belong to a user
# in the named tenant. Required only when running `python -m src.pipelines.scheduler`.
PIPELINE_TENANT_ID=
PIPELINE_USER_JWT=

# Cron-ish intervals (minutes). Defaults: re-embed daily, snapshot hourly.
PIPELINE_REEMBED_INTERVAL_MIN=1440
PIPELINE_BALANCE_INTERVAL_MIN=60

# ─── Phase 6: Google OAuth (Gmail / Drive / Calendar) ──────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8501 (Streamlit default)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501

# ─── Phase 6: WhatsApp Business API ────────────────────────────
# System-user access token from Meta Business Manager + Phone Number ID.
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Phase 6: Token encryption ─────────────────────────────────
# Fernet key for encrypting OAuth refresh/access tokens stored in
# ai_connected_services. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ─── Phase 7: agent engine ─────────────────────────────────────
# loop  = handwritten while-loop (Phase 2, default — fast, no extras)
# graph = LangGraph state machine (planner/executor split, checkpointer,
#         memory retrieval, LangSmith tracing).  The sidebar in Streamlit
#         lets you switch per-turn; this is just the default.
AGENT_ENGINE=loop

# ─── Phase 7: LangSmith tracing (optional) ─────────────────────
# Get a key at https://smith.langchain.com (free tier).  Set TRACING=true
# and the LangGraph nodes + LiteLLM calls will appear as spans in the
# named project.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=erp-ai-companion

# ─── Phase 7: LangGraph checkpointer ───────────────────────────
# Path to a SQLite file for persistent agent state (HITL pauses survive
# Streamlit restarts).  Empty = in-memory MemorySaver only (lost on restart).
# Requires `uv sync --extra checkpoint-sqlite` to install the SqliteSaver.
LANGGRAPH_SQLITE_PATH=
