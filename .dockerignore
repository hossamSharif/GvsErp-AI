# Keep the build context small. Only apps/api + packages/{database,shared}
# are needed for the API image — everything else is excluded.

# Dependencies & build output
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/.cache

# Apps not built in this image
apps/web
apps/ai

# Packages not needed by the API
packages/ui

# VCS, editor, OS
.git
.gitignore
.github
.vscode
.idea
.DS_Store
Thumbs.db

# Secrets — never bake into images
**/.env
**/.env.*
!**/.env.example

# Local-only artifacts
.claude
.playwright-mcp
.specify
*.png
*.log
*.tsbuildinfo

# Docs / planning
docs
specs
**/*.md
!README.md

# Test outputs
test-results
playwright-report
